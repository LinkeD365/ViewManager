{
  "name": "pptb-viewstudio",
  "version": "0.1.0",
  "displayName": "View Studio",
  "description": "A Power Platform ToolBox tool that allows users to manage and view personal views in Dataverse.",
  "features": {
    "connections": {
      "min": 1,
      "max": 10
    }
  },
  "main": "dist/index.html",
  "author": "LinkeD365",
  "contributors": [
    {
      "name": "LinkeD365"
    }
  ],
  "configurations": {
    "repository": "https://github.com/LinkeD365/ViewStudio",
    "readmeUrl": "https://raw.githubusercontent.com/LinkeD365/ViewStudio/main/README.md"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite",
    "watch": "vite build --watch",
    "preview": "vite preview",
    "test": "node --test",
    "finalize-package": "npm shrinkwrap",
    "validate": "pptb-validate"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.72.7",
    "@fluentui/react-icons": "^2.0.344",
    "ag-grid-community": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "mobx": "^6.15.0",
    "mobx-react": "^9.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@pptb/types": "^1.2.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^7.1.11"
  },
  "files": [
    "dist",
    "IMPLEMENTATION.md",
    "npm-shrinkwrap.json"
  ]
}
